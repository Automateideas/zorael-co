# ─────────────────────────────────────────────────────────────
# ZORAEL & CO. — environment configuration
# Copy to `.env.local` and fill in as needed.
# With NO variables set, the app runs on the built-in "mock" gateway,
# so checkout works end-to-end locally with no real money.
# ─────────────────────────────────────────────────────────────

# ── Database (Drizzle + PostgreSQL) ──
# Leave BOTH unset to use the in-memory order store (no DB needed locally).
#
# DATABASE_URL  → the app's runtime connection. On Vercel, point this at your
#                 POOLER (PgBouncer, transaction mode), e.g. port 6432.
# DIRECT_URL    → a DIRECT connection to Postgres (:5432) used only by
#                 drizzle-kit migrations. Omit locally to reuse DATABASE_URL.
DATABASE_URL=postgres://zorael:password@your-host:6432/zorael
DIRECT_URL=postgres://zorael:password@your-host:5432/zorael
# TLS: default requires SSL (recommended for remote DBs). Set to "disable" only
# for a local Postgres with no TLS.
DB_SSL=require
# Max connections PER serverless instance — keep small behind a pooler.
DB_POOL_MAX=1

# Which payment provider to use: mock | http | razorpay | stripe
PAYMENT_PROVIDER=mock

# ── Option A: Generic HTTP provider ("just replace the URL") ──
# Point this at any REST payment service that follows the contract in
# src/lib/payments/http-gateway.ts, then set PAYMENT_PROVIDER=http.
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Option B: Razorpay (INR / UPI / cards) ──
# Set PAYMENT_PROVIDER=razorpay and fill these in.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Option C: Stripe (scaffolded; implement StripeGateway to enable) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
